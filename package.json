{
  "name": "@server/next",
  "version": "0.52.4",
  "description": "A fully-fledged web server with routing, file uploads, sessions, static files, schema validation, websockets, testing, etc.",
  "homepage": "https://server-js.com/",
  "repository": "github:franciscop/server-next",
  "author": "Francisco Presencia <public@francisco.io> (https://francisco.io/)",
  "funding": "https://www.paypal.me/franciscopresencia/19",
  "license": "UNLICENSED",
  "keywords": [
    "server",
    "node",
    "server.js"
  ],
  "scripts": {
    "build": "npm run build:bundle && npm run build:types && npm run build:prettier",
    "build:bundle": "bunx tsup src/index.ts --format esm --out-dir . --target node24 --external zod --external @valibot/to-json-schema",
    "build:types": "dts-bundle-generator --out-file index.d.ts --no-check --export-referenced-types false --inline-declare-global src/index.ts",
    "build:prettier": "prettier --write src *.ts *.json",
    "start": "bun test --watch",
    "lint": "oxlint src --ignore-pattern \"*.test-d.ts\" && tsc --noEmit",
    "test": "bun test src demo"
  },
  "main": "index.js",
  "type": "module",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "src/jsx/*.js",
    "src/jsx/jsx-runtime.d.ts"
  ],
  "exports": {
    ".": "./index.js",
    "./index.d.ts": "./index.d.ts",
    "./jsx-runtime": {
      "types": "./src/jsx/jsx-runtime.d.ts",
      "default": "./src/jsx/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./src/jsx/jsx-runtime.d.ts",
      "default": "./src/jsx/jsx-dev-runtime.js"
    }
  },
  "documentation.page": {
    "title": "Server JS - A modern web server for Bun and Node.js",
    "home": "./docs/index.html",
    "menu": {
      "Documentation": "/documentation",
      "Tutorials": "/tutorials",
      "Donate": "https://www.paypal.com/paypalme/franciscopresencia/19",
      "Github": "https://github.com/franciscop/server-next"
    },
    "documentation": {
      "Documentation": "docs/0. Documentation.md",
      "Options": "docs/1. Options.md",
      "Router": "docs/2. Router.md",
      "Context": "docs/3. Context.md",
      "Reply": "docs/4. Reply.md",
      "Authentication": "docs/5. Authentication.md",
      "Testing": "docs/6. Testing.md",
      "Concepts": "docs/7. Concepts.md",
      "Errors": "docs/8. Errors.md",
      "FAQ": "docs/9. FAQ.md"
    },
    "tutorials": "docs/tutorials"
  },
  "dependencies": {
    "antarctic": "^0.7.0",
    "bucket": "^0.11.4"
  },
  "devDependencies": {
    "@endosome/dts-bundle-generator": "9.6.0",
    "@server/next": "file:",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@valibot/to-json-schema": "^1.8.0",
    "arktype": "^2.2.9",
    "bun": "^1.4.4",
    "check-dts": "^2.0.1",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "zod": "^4.6.7"
  }
}
